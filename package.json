{
  "name": "@defined-net/mcp-server",
  "version": "1.0.0",
  "description": "MCP server for managing Nebula overlay networks via the Defined Networking API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "defined-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test": "npm run build && npm run test:dry-run",
    "test:dry-run": "node scripts/mcp-smoke.mjs dry-run",
    "test:live": "node scripts/mcp-smoke.mjs all",
    "security:audit": "npm audit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/geoffbelknap/defined-mcp"
  },
  "keywords": [
    "mcp",
    "nebula",
    "defined-networking",
    "overlay-network",
    "vpn",
    "ai-agent",
    "openclaw"
  ],
  "author": "Geoff Belknap",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
